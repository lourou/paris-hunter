# paris-hunter environment — single source of truth (owned by lane 1, frozen).
# Local/dev runs: yarn start:paris-hunter (node --env-file-if-exists=.env).
# Docker: compose env_file. No dotenv dependency.

# Stream Estate
STREAM_ESTATE_API_KEY=
STREAM_ESTATE_WEBHOOK_SECRET=          # >=32 chars REQUIRED (boot-fatal); generate: openssl rand -hex 24
PUBLIC_BASE_URL=                       # https://hunter.example.com — used to register webhook URLs
# Search band (server-side band is WIDENED; local guard is strict HC)
PH_SERVER_BUDGET_MIN=2400
PH_SERVER_BUDGET_MAX=3350
PH_BUDGET_HC_MIN=2500
PH_BUDGET_HC_MAX=3100
PH_ZIPS=75011,75012
PH_ROOMS_MIN=3
PH_ROOMS_MAX=4
PH_CAP_TABLE_JSON=                     # optional override, e.g. {"75011":34,...}
PH_MONTHLY_ITEM_BUDGET=900             # auto-disable ceiling (items/month proxy ~ EUR 9 PAYG)
# PH_FAILPOINT=                        # QA only — never set in production
# Fredy
FREDY_SKIP_CHROMIUM=true
# Convos / XMTP (contract doc §2, except attachment storage — see below)
CONVOS_ENABLED=true
XMTP_ENV=production                    # dev for QA; MUST match invite origin app
CONVOS_DATA_DIR=/data/convos
CONVOS_INVITE_URL=
CONVOS_PROFILE_NAME=Paris Hunter
# Photo attachment storage (ciphertext blobs; DEFAULT = s3 -> Scaleway Object Storage)
ATTACHMENT_STORE=s3                    # s3 | local   (Convos presigned API deliberately NOT supported)
# Scaleway S3-compatible creds — EXACT names, already present in repo .env:
SCW_S3_ENDPOINT=https://s3.fr-par.scw.cloud
SCW_S3_REGION=fr-par
SCW_S3_BUCKET=paris-hunter
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=170ae12b-a82c-4e65-ab50-cd2a08446769   # not used by S3 API; kept for scw CLI
SCW_DEFAULT_PROJECT_ID=170ae12b-a82c-4e65-ab50-cd2a08446769
# SCW_LIFECYCLE_ACCESS_KEY=            # optional admin pair for setup-bucket.js ONLY
# SCW_LIFECYCLE_SECRET_KEY=            # (run from operator machine; keep off the VPS)
ATTACHMENTS_PUBLIC_BASE=               # optional override; default derived: https://<bucket>.s3.<region>.scw.cloud
# local fallback (only read when ATTACHMENT_STORE=local — dev/QA):
ATTACHMENTS_DIR=/data/attachments
ATTACHMENTS_RETENTION_DAYS=180         # local store only; s3 retention = bucket lifecycle rule (180d, set at deploy)
