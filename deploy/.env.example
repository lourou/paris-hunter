# Compose ${} interpolation vars. `docker compose -f deploy/compose.yml` uses
# deploy/ as the project directory, so interpolation reads THIS folder's .env —
# NOT the repo-root .env consumed via env_file. Copy to deploy/.env and fill in
# (deploy/.env is gitignored):
#
#   cp deploy/.env.example deploy/.env
#
# VPS public IPv4 (what `dig +short hunter.10u15.net` prints). Caddy binds
# 80/443 on this address ONLY, leaving the Tailscale IP's :443 free for
# `tailscale serve` (docs/DEPLOY.md §12).
PUBLIC_BIND_IP=<VPS public IPv4>
