# paris-hunter — production Caddyfile.
# fredy.example.com (DNS A record → VPS IP). TLS certificates are automatic
# (Let's Encrypt) once DNS resolves.
#
# This vhost serves ONLY the Stream Estate webhook. The Fredy admin UI is NOT
# internet-exposed: it is reached over Tailscale via `tailscale serve` against
# the loopback-only port mapping (see deploy/compose.yml and docs/DEPLOY.md
# "Admin UI over Tailscale").

fredy.example.com {
	# --- Access log (incident 2026-07-12) ------------------------------------
	# Log EVERY request on this vhost (webhook hits, 403 denies, 404s) to stdout
	# (`docker logs paris-hunter-caddy-1`): without it, a delivery answered 200
	# left no trace anywhere between Stream Estate and the app. The webhook
	# secret travels as a path segment — redact it before it reaches the log.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp /api/webhook/stream-estate/[^/]+ /api/webhook/stream-estate/<redacted>
			}
		}
	}

	# --- Stream Estate webhook ---------------------------------------------
	# Two factors: IP allowlist here (Stream Estate egress IP) + the secret
	# path segment checked in-app (timingSafeEqual). While testing against the
	# Stream Estate SANDBOX, add its IP too:  remote_ip 144.76.91.183 178.238.226.136
	@webhook {
		path_regexp stream_estate_delivery ^/api/webhook/stream-estate/[^/]+/(match|event)$
		remote_ip 144.76.91.183
	}
	handle @webhook {
		reverse_proxy fredy:9998
	}

	# Receiver liveness is a distinct GET-only gate for bootstrap enablement.
	# Docker/localhost sources are allowed; append the VPS/operator source IP if
	# PUBLIC_BASE_URL hairpins through a public interface on your host.
	@webhook_health {
		method GET
		path_regexp stream_estate_health ^/api/webhook/stream-estate/[^/]+/health$
		remote_ip private_ranges
	}
	handle @webhook_health {
		reverse_proxy fredy:9998
	}

	# Same path from any other IP → flat 403 (never reaches the app).
	@webhook_denied {
		path /api/webhook/*
	}
	handle @webhook_denied {
		respond 403
	}

	# --- Everything else: nothing to see ------------------------------------
	# The admin UI is deliberately NOT proxied here — it is Tailscale-only.
	# 404 (not 403) so the public surface doesn't advertise that anything
	# gated exists at this host; the webhook paths above keep their distinct
	# 403 for allowlist diagnostics.
	handle {
		respond 404
	}

	# NOTE: no /attachments route on purpose — photo ciphertext blobs are
	# served directly by Scaleway Object Storage:
	#   https://paris-hunter.s3.fr-par.scw.cloud/attachments/<file>
}

# --- Scanner noise: unknown hosts get NO answer ----------------------------
# Anything not addressed to fredy.example.com by name (bare-IP probes, empty
# Host headers, random vhosts) gets the connection ABORTED — no status line,
# no auto-HTTPS 308 redirect to fingerprint (observed live 2026-07: Mozi
# botnet probes and inventory scanners collecting the default redirect).
# Host-matched sites sort before catch-alls, so the vhost above always wins.

# Port 80, catch-all. Caddy still auto-creates the HTTP->HTTPS redirect for
# fredy.example.com and that host-matched route matches first; every other
# Host (or none) falls through to here and is dropped mid-connection.
#
# Port 443 needs NO catch-all: with no certificate for an unknown or absent
# SNI, Caddy natively refuses the TLS handshake (dead socket, nothing
# minted, no ACME). Do NOT add an `https:// { tls internal { on_demand } }`
# block — on-demand issuance mints an internal cert for EVERY bogus SNI
# (unbounded, abuse-able, logs "YOUR SERVER MAY BE VULNERABLE TO ABUSE")
# and COMPLETES handshakes that would otherwise fail silently.
http:// {
	abort
}
